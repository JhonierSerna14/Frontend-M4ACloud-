# ─────────────────────────────────────────────────────────────────────────────
# M4A Frontend — Variables de entorno (DESARROLLO LOCAL)
# Copiá este archivo como .env y completá los valores si es necesario.
# El archivo .env NO se commitea (está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# URL base del backend al que apunta el proxy del servidor de desarrollo de Vite.
# Cambiá el puerto si tu backend corre en otro lugar.
VITE_BACKEND_TARGET=http://localhost:8000

# URL completa del backend (SOLO para builds de producción / Vercel).
# En desarrollo local esta variable NO se usa — el proxy de Vite la reemplaza.
# VITE_API_URL=https://TU-BACKEND.onrender.com/api
